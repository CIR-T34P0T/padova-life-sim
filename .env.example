# Environment variables used by the project.
# The server reads these from the shell environment (it does not load a .env
# file). Vite loads VITE_* variables from client/.env if you create one.

# Game server
PORT=2567
LOG_LEVEL=info
# LOG_FORMAT=json   (one JSON object per log line, for a hosting provider's log collector)

# Database. Leave DATABASE_URL unset to use the embedded PGlite database
# stored in .data/pglite. DATABASE_URL contains a password: never commit it,
# and never put it in a VITE_* variable (those are sent to the browser).
# DATABASE_URL=postgresql://user:password@localhost:5432/padova
# PGLITE_DATA_DIR=.data/pglite
# DB_MIGRATE_ON_START=true
# GUEST_CREATIONS_PER_IP_PER_HOUR=10
# Game minutes per real minute (1–1440). Changing it moves the world clock;
# meant for development and testing (docs/DECISIONS.md D-021).
# GAME_TIME_SCALE=10
# Shifts the world clock by whole game minutes (up to a week either way), e.g.
# to try the café's opening hours (06:00–23:00) at any real time (D-036).
# GAME_CLOCK_OFFSET_MINUTES=0

# Client
CLIENT_PORT=5173
# VITE_SERVER_URL=ws://localhost:2567

# Tests (optional)
# CHROMIUM_PATH=
# TEST_DATABASE_URL=postgresql://user:password@localhost:5432/postgres
# E2E_DATABASE_URL=postgresql://user:password@localhost:5432/padova_e2e
# E2E_CLOCK_OFFSET_MINUTES=
