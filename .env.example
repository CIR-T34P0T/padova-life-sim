# Environment variables used by the project. No secrets are required yet.
# The server reads these from the shell environment (it does not load a .env
# file). Vite loads VITE_* variables from client/.env if you create one.

# Game server
PORT=2567
LOG_LEVEL=info

# Client
CLIENT_PORT=5173
# VITE_SERVER_URL=ws://localhost:2567

# End-to-end tests: optional path to an existing Chromium binary
# CHROMIUM_PATH=
