# Padova Life SIM game server (M12, D-047). Installed by deploy/setup.sh,
# which replaces @APP_DIR@. Settings and the database password live in
# /etc/padova-life/env (readable by root and the padova user only).
[Unit]
Description=Padova Life SIM game server
After=network-online.target postgresql.service
Wants=network-online.target
Requires=postgresql.service

[Service]
Type=simple
User=padova
Group=padova
WorkingDirectory=@APP_DIR@
EnvironmentFile=/etc/padova-life/env
ExecStart=@APP_DIR@/node_modules/.bin/tsx server/src/index.ts
Restart=on-failure
RestartSec=3
# The game reads its code and talks to PostgreSQL and the network; nothing else.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
