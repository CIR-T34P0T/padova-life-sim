{
  "name": "padova-life-sim",
  "version": "0.1.0",
  "private": true,
  "description": "Padova Life SIM: browser-based 3D multiplayer life simulation set in Padua.",
  "type": "module",
  "workspaces": [
    "shared",
    "server",
    "client"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run build -w client && npm run build -w server",
    "start": "npm run start -w server",
    "typecheck": "npm run typecheck --workspaces",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm test",
    "db:migrate": "npm run db:migrate -w server",
    "db:rollback": "npm run db:rollback -w server",
    "db:status": "npm run db:status -w server",
    "clock": "npm run clock -w server --silent --",
    "reports": "npm run reports -w server --silent --"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "^22.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
